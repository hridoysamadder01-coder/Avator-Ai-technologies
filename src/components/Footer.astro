---
import { NAV, SITE, href } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell">
    <div class="foot-cta rv">
      <p class="mono steel">Next step</p>
      <p class="foot-statement h2">
        Bring a problem worth<br />building a system for.
      </p>
      <div class="foot-actions">
        <a class="btn btn--solid" href={href('/contact/')}>
          Talk to AVATOR <span class="tick" aria-hidden="true">→</span>
        </a>
        <a class="btn" href={href('/enterprise/')}>
          Enterprise access <span class="tick" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="foot-grid">
      <nav class="foot-col" aria-label="Footer — explore">
        <p class="mono steel">Explore</p>
        <ul>
          {NAV.map((item) => (
            <li><a href={href(item.path)}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav class="foot-col" aria-label="Footer — engage">
        <p class="mono steel">Engage</p>
        <ul>
          <li><a href={href('/contact/')}>Contact</a></li>
          <li><a href={href('/developers/')}>Developer access</a></li>
          <li><a href={href('/enterprise/')}>Enterprise</a></li>
          <li><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></li>
        </ul>
      </nav>
      <div class="foot-col">
        <p class="mono steel">Position</p>
        <ul>
          <li class="mono foot-coord">{SITE.coordinates}</li>
          <li>Engineered in Bangladesh.</li>
          <li>Built for the world.</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="foot-mark" aria-hidden="true">AVATOR</div>

  <div class="shell foot-base">
    <p class="mono">© {year} {SITE.name}</p>
    <p class="mono steel">Independent AI technology company</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    margin-top: var(--sect);
    overflow: clip;
  }

  .foot-cta {
    padding-block: clamp(4rem, 9vh, 7rem) clamp(3rem, 6vh, 5rem);
    display: grid;
    gap: 1.6rem;
  }

  .foot-statement {
    max-width: 14em;
  }

  .foot-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.6rem;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--line);
  }

  .foot-col ul {
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
    display: grid;
    gap: 0.55rem;
  }

  .foot-col a,
  .foot-col li {
    color: var(--bone-1);
    font-size: 0.92rem;
  }

  .foot-col a:hover,
  .foot-col a:focus-visible {
    color: var(--signal);
  }

  .foot-coord {
    color: var(--steel);
    letter-spacing: 0.12em;
  }

  .foot-mark {
    font-weight: 740;
    font-stretch: 124%;
    letter-spacing: 0.02em;
    font-size: clamp(5rem, 21vw, 21rem);
    line-height: 0.78;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px rgba(236, 233, 224, 0.1);
    user-select: none;
    transform: translateY(0.1em);
  }

  .foot-base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .foot-base .mono {
    color: var(--steel);
    letter-spacing: 0.14em;
  }

  @media (max-width: 720px) {
    .foot-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.4rem;
    }
  }
</style>
