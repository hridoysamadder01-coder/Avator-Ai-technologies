---
/**
 * The AVATOR attention field — an interactive lattice of oriented marks that
 * align toward a point of attention (the cursor, or an autonomous attractor),
 * crossed by periodic signal wavefronts.
 *
 * Engineering: canvas 2D, DPR capped at 2, delta-time driven (rate-independent),
 * paused when offscreen or tab-hidden, one static frame under reduced motion,
 * and a visible pause control (WCAG 2.2.2).
 */
---

<canvas class="signal-field" data-signal-field aria-hidden="true"></canvas>
<button
  class="field-toggle mono"
  data-field-toggle
  aria-pressed="true"
  title="Pause background motion"
>
  <span class="ft-dot" aria-hidden="true"></span>
  <span data-field-label>Field · live</span>
</button>

<style>
  .signal-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .field-toggle {
    position: absolute;
    right: var(--gutter);
    bottom: 1.4rem;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: var(--steel);
    letter-spacing: 0.16em;
    padding: 0.5em 0.2em;
    transition: color var(--sp-ui) var(--ease-out);
  }

  .field-toggle:hover,
  .field-toggle:focus-visible {
    color: var(--bone-0);
  }

  .ft-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 8px rgba(240, 161, 62, 0.7);
  }

  .field-toggle[aria-pressed='false'] .ft-dot {
    background: var(--steel-dim);
    box-shadow: none;
  }

  @media (max-width: 720px) {
    .field-toggle {
      bottom: 1rem;
    }
  }
</style>

<script>
  const canvasEl = document.querySelector('[data-signal-field]') as HTMLCanvasElement | null;
  const toggle = document.querySelector('[data-field-toggle]') as HTMLButtonElement | null;
  const toggleLabel = document.querySelector('[data-field-label]');

  if (canvasEl) {
    const canvas = canvasEl;
    const ctx = canvas.getContext('2d', { alpha: true })!;
    const motionMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(pointer: fine)').matches;

    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const SPACING = 34;
    const DASH = 10;

    let w = 0;
    let h = 0;
    let nodes: { x: number; y: number; a: number; phase: number; beacon: boolean }[] = [];

    const attractor = { x: 0, y: 0, tx: 0, ty: 0 };
    const pointer = { x: 0, y: 0, active: false };
    let waves: { x: number; y: number; r: number }[] = [];
    let waveClock = 0;
    let raf = 0;
    let running = false;
    let userPaused = false;
    let onScreen = true;
    let t = 0; // simulation clock, seconds
    let last = 0;

    function build() {
      const rect = canvas.parentElement!.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * DPR);
      canvas.height = Math.round(h * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

      nodes = [];
      const cols = Math.ceil(w / SPACING) + 1;
      const rows = Math.ceil(h / SPACING) + 1;
      for (let iy = 0; iy < rows; iy++) {
        for (let ix = 0; ix < cols; ix++) {
          // deterministic jitter — organic lattice, no per-frame randomness
          const jx = Math.sin(ix * 12.9898 + iy * 78.233) * 5;
          const jy = Math.cos(ix * 4.898 + iy * 7.23) * 5;
          nodes.push({
            x: ix * SPACING + jx,
            y: iy * SPACING + jy,
            a: 0,
            phase: Math.sin(ix * 3.7 + iy * 1.3) * Math.PI,
            beacon: (ix * 31 + iy * 17) % 97 === 3,
          });
        }
      }
      attractor.x = attractor.tx = w * 0.72;
      attractor.y = attractor.ty = h * 0.38;
    }

    // exponential smoothing that is stable across frame rates
    const ease = (k: number, dt: number) => 1 - Math.pow(1 - k, dt * 60);

    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.033);
      last = now;
      t += dt;

      if (pointer.active) {
        attractor.tx = pointer.x;
        attractor.ty = pointer.y;
      } else {
        attractor.tx = w * (0.5 + 0.33 * Math.sin(t * 0.13));
        attractor.ty = h * (0.42 + 0.24 * Math.sin(t * 0.094 + 1.7));
      }
      const ka = ease(0.045, dt);
      attractor.x += (attractor.tx - attractor.x) * ka;
      attractor.y += (attractor.ty - attractor.y) * ka;

      waveClock += dt;
      if (waveClock > 4.2) {
        waveClock = 0;
        waves.push({ x: attractor.x, y: attractor.y, r: 0 });
      }
      waves.forEach((wv) => (wv.r += 190 * dt));
      waves = waves.filter((wv) => wv.r < Math.max(w, h) * 1.2);

      draw(dt);
      raf = requestAnimationFrame(frame);
    }

    function draw(dt: number) {
      ctx.clearRect(0, 0, w, h);
      const maxD = Math.hypot(w, h) * 0.42;
      const kr = ease(0.08, dt || 0.016);

      for (const n of nodes) {
        const dx = attractor.x - n.x;
        const dy = attractor.y - n.y;
        const dist = Math.hypot(dx, dy) || 1;

        const target = Math.atan2(dy, dx);
        let delta = target - n.a;
        delta = Math.atan2(Math.sin(delta), Math.cos(delta));
        n.a += delta * kr;

        const prox = Math.max(0, 1 - dist / maxD);
        let alpha = 0.05 + prox * prox * 0.5 + Math.sin(t * 1.4 + n.phase) * 0.015;

        let waveBoost = 0;
        for (const wv of waves) {
          const wd = Math.abs(Math.hypot(n.x - wv.x, n.y - wv.y) - wv.r);
          if (wd < 46) waveBoost = Math.max(waveBoost, (1 - wd / 46) * 0.55);
        }
        alpha += waveBoost;

        const len = DASH * (0.55 + prox * 0.85);
        const ca = Math.cos(n.a) * len * 0.5;
        const sa = Math.sin(n.a) * len * 0.5;

        ctx.strokeStyle =
          waveBoost > 0.3
            ? `rgba(240, 161, 62, ${Math.min(alpha, 0.9)})`
            : `rgba(236, 233, 224, ${Math.min(alpha, 0.75)})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(n.x - ca, n.y - sa);
        ctx.lineTo(n.x + ca, n.y + sa);
        ctx.stroke();

        if (n.beacon) {
          ctx.fillStyle = `rgba(240, 161, 62, ${0.25 + 0.3 * Math.abs(Math.sin(t * 0.8 + n.phase))})`;
          ctx.beginPath();
          ctx.arc(n.x, n.y, 1.6, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    function drawStatic() {
      attractor.x = w * 0.72;
      attractor.y = h * 0.38;
      for (const n of nodes) {
        n.a = Math.atan2(attractor.y - n.y, attractor.x - n.x);
      }
      waves = [];
      draw(0.016);
    }

    function shouldRun() {
      return !motionMq.matches && !userPaused && onScreen && !document.hidden;
    }

    function start() {
      if (running || !shouldRun()) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    function sync() {
      if (shouldRun()) start();
      else stop();
    }

    build();
    if (motionMq.matches) drawStatic();
    else start();

    motionMq.addEventListener('change', () => {
      if (motionMq.matches) {
        stop();
        drawStatic();
        if (toggle) toggle.hidden = true;
      } else {
        if (toggle) toggle.hidden = false;
        sync();
      }
    });

    if (toggle) {
      if (motionMq.matches) toggle.hidden = true;
      toggle.addEventListener('click', () => {
        userPaused = !userPaused;
        toggle.setAttribute('aria-pressed', String(!userPaused));
        toggle.title = userPaused ? 'Resume background motion' : 'Pause background motion';
        if (toggleLabel) toggleLabel.textContent = userPaused ? 'Field · paused' : 'Field · live';
        if (userPaused) {
          stop();
          drawStatic();
        } else {
          sync();
        }
      });
    }

    if (finePointer) {
      const host = canvas.closest('[data-hero]') || canvas.parentElement!;
      host.addEventListener('pointermove', (e) => {
        const rect = canvas.getBoundingClientRect();
        pointer.x = (e as PointerEvent).clientX - rect.left;
        pointer.y = (e as PointerEvent).clientY - rect.top;
        pointer.active = true;
      });
      host.addEventListener('pointerleave', () => {
        pointer.active = false;
      });
    }

    document.addEventListener('visibilitychange', sync);

    const vis = new IntersectionObserver(
      ([entry]) => {
        onScreen = !!entry?.isIntersecting;
        sync();
      },
      { threshold: 0, rootMargin: '100px' },
    );
    vis.observe(canvas);

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        build();
        if (!running) drawStatic();
      }, 150);
    });
  }
</script>
