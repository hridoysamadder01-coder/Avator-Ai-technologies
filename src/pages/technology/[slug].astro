---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('technologies');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const statusLabel: Record<string, string> = {
  active: 'Active',
  development: 'In development',
  research: 'Research',
};

const all = (await getCollection('technologies')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all[(idx + 1) % all.length];
---

<Base
  title={entry.data.title}
  description={entry.data.summary}
  path={`/technology/${entry.id}/`}
>
  <article>
    <header class="t-head dots-bg">
      <div class="shell">
        <p class="mono t-crumb rv">
          <a href={href('/technology/')}>Technology</a>
          <span aria-hidden="true"> / </span>
          <span class="sig">{entry.data.designation}</span>
        </p>
        <h1 class="t-title kin">{entry.data.title}</h1>
        <div class="t-meta rv" style="--rv-d: 0.2s">
          <span class="chip" data-state={entry.data.status}>{statusLabel[entry.data.status]}</span>
          <span class="mono steel">{entry.data.designation}</span>
        </div>
      </div>
    </header>

    <div class="shell t-body">
      <aside class="t-side rv">
        <p class="mono steel side-lbl">Capabilities</p>
        <ul class="side-caps">
          {entry.data.capabilities.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </aside>
      <div class="t-prose rv" style="--rv-d: 0.1s">
        <p class="lede">{entry.data.summary}</p>
        <div class="prose">
          <Content />
        </div>
        <div class="t-cta">
          <a class="btn" href={href('/contact/')}>
            Discuss this capability <span class="tick" aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={href(`/technology/${next.id}/`)}>
            Next: {next.data.title} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .t-head {
    padding-block: clamp(9rem, 18vh, 12rem) clamp(2.5rem, 6vh, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .t-crumb {
    letter-spacing: 0.2em;
    color: var(--steel);
    margin-bottom: 1.4rem;
  }

  .t-crumb a:hover {
    color: var(--bone-0);
  }

  .t-title {
    font-size: clamp(2.4rem, 7vw, 6rem);
    line-height: 1;
    font-weight: 560;
    font-stretch: 114%;
    letter-spacing: -0.02em;
  }

  .t-meta {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 1.6rem;
  }

  .t-meta .steel {
    letter-spacing: 0.18em;
  }

  .t-body {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: clamp(3rem, 8vh, 6rem);
  }

  .side-lbl {
    letter-spacing: 0.22em;
  }

  .side-caps {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .side-caps li {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    color: var(--bone-1);
    font-size: 0.95rem;
  }

  .side-caps li::before {
    content: '— ';
    color: var(--signal);
  }

  .prose {
    margin-top: 2rem;
    color: var(--bone-1);
    max-width: 40em;
  }

  .prose :global(p + p) {
    margin-top: 1.2em;
  }

  .t-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.6rem;
    margin-top: 3rem;
  }

  @media (max-width: 860px) {
    .t-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .t-side {
      order: 2;
    }

    .t-prose {
      order: 1;
    }
  }
</style>
