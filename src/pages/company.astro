---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE, href } from '../lib/site';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Company"
  description="AVATOR AI TECHNOLOGIES is an independent AI technology company founded by Hridoy Samadder — building applied intelligence systems from Bangladesh for a global market."
  path="/company/"
>
  <PageIntro
    eyebrow="Company — who is building this"
    title="An independent company, built deliberately."
    lede="No venture template, no borrowed playbook. AVATOR is being built the way its systems are built: carefully, completely and to last."
  />

  <section class="section" aria-labelledby="c1">
    <div class="shell co-split">
      <div>
        <div class="sect-head">
          <span class="idx">01</span>
          <h2 class="lbl" id="c1">Identity</h2>
          <span class="rule rule-draw"></span>
        </div>
        <p class="statement kin">
          The company is the roof. Everything we make lives under it.
        </p>
      </div>
      <div class="co-copy">
        <p class="body-copy rv">
          AVATOR AI TECHNOLOGIES was founded by <strong>{SITE.founder}</strong> as
          an independent AI technology company. It exists to do one thing
          well: engineer intelligence into complete systems — software that
          works on the counter of a pharmacy, in a classroom, on a trading
          desk, and eventually far beyond them.
        </p>
        <p class="body-copy rv" style="--rv-d: 0.08s">
          The company operates from {SITE.origin}, and builds for a global
          market. That origin is not a footnote — systems engineered for hard
          conditions first hold everywhere else.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="c2">
    <div class="shell">
      <div class="sect-head">
        <span class="idx">02</span>
        <h2 class="lbl" id="c2">Operating principles</h2>
        <span class="rule rule-draw"></span>
      </div>
      <ol class="prin-grid">
        <li class="rv">
          <span class="mono sig">PR·01</span>
          <h3 class="h3">Complete systems</h3>
          <p class="dim">We ship whole products — interface, data, intelligence, deployment — not fragments that need three other vendors.</p>
        </li>
        <li class="rv" style="--rv-d: 0.06s">
          <span class="mono sig">PR·02</span>
          <h3 class="h3">Reality is the benchmark</h3>
          <p class="dim">A system is judged where it runs, not where it demos. If it can't survive real conditions, it isn't done.</p>
        </li>
        <li class="rv" style="--rv-d: 0.12s">
          <span class="mono sig">PR·03</span>
          <h3 class="h3">Honest signal</h3>
          <p class="dim">No invented customers, no imaginary metrics, no announcements before things exist. What we publish, you can check.</p>
        </li>
        <li class="rv" style="--rv-d: 0.18s">
          <span class="mono sig">PR·04</span>
          <h3 class="h3">Capability compounds</h3>
          <p class="dim">Every product feeds the platform under it. Every experiment feeds the products. Nothing is built twice.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="c3">
    <div class="shell dir-split">
      <div>
        <div class="sect-head">
          <span class="idx">03</span>
          <h2 class="lbl" id="c3">Direction</h2>
          <span class="rule rule-draw"></span>
        </div>
        <div class="dir-log">
          <div class="dir-row rv">
            <span class="mono sig">NOW</span>
            <p>
              Applied platforms in operation and development — operations,
              education, market signal — with the shared technology base
              growing beneath them.
            </p>
          </div>
          <div class="dir-row rv" style="--rv-d: 0.08s">
            <span class="mono sig">BUILDING</span>
            <p>
              The first commercial product line, and the API platform that
              exposes its capabilities to developers.
            </p>
          </div>
          <div class="dir-row rv" style="--rv-d: 0.16s">
            <span class="mono sig">AHEAD</span>
            <p>
              An ecosystem of products, APIs and research under one roof — an
              AI technology company measured by what its systems do in the
              world.
            </p>
          </div>
        </div>
      </div>

      <div id="research">
        <div class="sect-head">
          <span class="idx">04</span>
          <h2 class="lbl">Research journal</h2>
          <span class="rule rule-draw"></span>
        </div>
        <div class="res-list">
          {research.map((r) => (
            <article class="res-item rv">
              <p class="mono sig">{r.data.designation} · {r.data.date}</p>
              <h3 class="h3">{r.data.title}</h3>
              <p class="dim">{r.data.summary}</p>
            </article>
          ))}
          <p class="mono steel res-more rv">Further notes publish as work matures.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="c4">
    <div class="shell">
      <div class="sect-head">
        <span class="idx">05</span>
        <h2 class="lbl" id="c4">Reach us</h2>
        <span class="rule rule-draw"></span>
      </div>
      <div class="reach-band">
        <p class="h2 kin">One inbox. Read by the founder.</p>
        <div class="hero-cta rv">
          <a class="btn btn--solid" href={`mailto:${SITE.contactEmail}`}>
            {SITE.contactEmail} <span class="tick" aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={href('/contact/')}>
            Contact page <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .co-split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .co-split .statement {
    max-width: 13em;
  }

  .co-copy {
    display: grid;
    gap: 1.4rem;
    padding-top: 0.4rem;
  }

  .prin-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem) clamp(2rem, 5vw, 6rem);
  }

  .prin-grid li {
    border-top: 1px solid var(--line-strong);
    padding-top: 1.3rem;
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .prin-grid .mono {
    letter-spacing: 0.18em;
  }

  .prin-grid .dim {
    font-size: 0.95rem;
    max-width: 32em;
  }

  .dir-split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .dir-log {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .dir-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .dir-row .mono {
    letter-spacing: 0.2em;
    padding-top: 0.25rem;
  }

  .dir-row p {
    color: var(--bone-1);
    max-width: 34em;
  }

  .res-list {
    display: grid;
    gap: 1.8rem;
  }

  .res-item {
    border-left: 1px solid var(--line-strong);
    padding-left: 1.5rem;
    display: grid;
    gap: 0.6rem;
  }

  .res-item .mono {
    letter-spacing: 0.16em;
  }

  .res-item .dim {
    font-size: 0.95rem;
    max-width: 34em;
  }

  .res-more {
    letter-spacing: 0.14em;
  }

  .reach-band {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  @media (max-width: 900px) {
    .co-split,
    .dir-split,
    .reach-band {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .prin-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
