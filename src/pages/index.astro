---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SignalField from '../components/SignalField.astro';
import { SITE, TECH_STATUS_LABEL, href, statusKey } from '../lib/site';

const technologies = (await getCollection('technologies')).sort(
  (a, b) => a.data.order - b.data.order,
);
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

const statusLabel = TECH_STATUS_LABEL;
---

<Base>
  <!-- 01 — identity -->
  <section class="hero" data-hero aria-label="AVATOR AI TECHNOLOGIES">
    <div class="glow hero-glow" aria-hidden="true"></div>
    <SignalField />
    <div class="hero-in shell" data-hero-parallax>
      <p class="mono hero-eyebrow rv">Independent AI technology company</p>
      <h1 class="hero-id">
        <span class="hero-word kin">AVATOR</span>{' '}
        <span class="hero-tail mono" data-scramble>AI&nbsp;TECHNOLOGIES</span>
      </h1>
      <p class="hero-statement statement kin">
        Intelligence, engineered into systems that hold.
      </p>
      <p class="hero-sub rv" style="--rv-d: 0.5s">
        We build language systems, autonomous agents and complete software
        platforms — engineered for the real world, not the demo.
      </p>
      <div class="hero-cta rv" style="--rv-d: 0.65s">
        <a class="btn btn--solid" href={href('/technology/')}>
          Explore the technology <span class="tick" aria-hidden="true">→</span>
        </a>
        <a class="btn" href={href('/contact/')}>
          Talk to AVATOR <span class="tick" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <p class="hero-coord mono" aria-hidden="true">{SITE.coordinates} — operating globally</p>
    <p class="hero-scroll mono" aria-hidden="true">Scroll ↓</p>
  </section>

  <!-- 02 — what we build -->
  <section class="section" aria-labelledby="s2">
    <div class="shell">
      <div class="sect-head">
        <span class="idx">02</span>
        <h2 class="lbl" id="s2">What we build</h2>
        <span class="rule rule-draw"></span>
      </div>
      <p class="statement kin manifesto">
        Applied intelligence: systems that read, reason and act — <span class="dim">built as complete software, deployed where work actually happens.</span>
      </p>
      <div class="build-cols">
        <p class="body-copy rv">
          AVATOR AI TECHNOLOGIES is the roof over a growing ecosystem of
          technologies, products and engineering work. One company, one
          standard: if a system can't survive a real counter, a real classroom
          or a real trading day, it isn't finished.
        </p>
        <p class="body-copy rv" style="--rv-d: 0.1s">
          We operate across the full stack — models applied to language and
          signal, agents that carry work forward, and the platforms, interfaces
          and data systems around them. Engineered in Bangladesh. Built for the world.
        </p>
      </div>
    </div>
  </section>

  <!-- 03 — technology index -->
  <section class="section" aria-labelledby="s3">
    <div class="shell">
      <div class="sect-head">
        <span class="idx">03</span>
        <h2 class="lbl" id="s3">Technology</h2>
        <span class="rule rule-draw"></span>
      </div>
      <ol class="tech-index">
        {technologies.map((t, i) => (
          <li class="rv" style={`--rv-d: ${i * 0.06}s`}>
            <a class="tech-row" href={href(`/technology/${t.id}/`)}>
              <span class="mono tech-code">{t.data.designation}</span>
              <span class="tech-name h3" transition:name={`tech-${t.id}`}>{t.data.title}</span>
              <span class="tech-sum">{t.data.summary}</span>
              <span class="chip" data-state={t.data.status}>{statusLabel[t.data.status]}</span>
              <span class="tech-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 — products / commercial architecture -->
  <section class="section" aria-labelledby="s4">
    <div class="shell">
      <div class="sect-head">
        <span class="idx">04</span>
        <h2 class="lbl" id="s4">Products</h2>
        <span class="rule rule-draw"></span>
      </div>
      <div class="prod-split">
        <div>
          <p class="h2 kin">Products ship under one roof.</p>
          <p class="body-copy rv">
            Everything commercial at AVATOR — software subscriptions, API
            access, enterprise licensing — belongs to the same ecosystem and
            meets the same engineering bar. The first product line is in
            private development now; releases will be announced here — and
            only once they exist.
          </p>
          <div class="prod-cta rv">
            <a class="text-link" href={href('/products/')}>
              The product pipeline <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <ul class="offer-list rv" style="--rv-d: 0.15s">
          <li>
            <span class="mono offer-code">CLASS·A</span>
            <div>
              <h3 class="h3">Software subscriptions</h3>
            <p class="dim">Complete products, monthly or yearly, for individuals and teams.</p>
            </div>
          </li>
          <li>
            <span class="mono offer-code">CLASS·B</span>
            <div>
              <h3 class="h3">API access</h3>
              <p class="dim">Programmable capability with usage-based plans, for builders.</p>
            </div>
          </li>
          <li>
            <span class="mono offer-code">CLASS·C</span>
            <div>
              <h3 class="h3">Enterprise licensing</h3>
              <p class="dim">Private deployments and custom agreements, for organizations.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 05 — selected systems -->
  <section class="section" aria-labelledby="s5">
    <div class="shell">
      <div class="sect-head">
        <span class="idx">05</span>
        <h2 class="lbl" id="s5">Selected systems</h2>
        <span class="rule rule-draw"></span>
      </div>
      <p class="lede rv">Evidence over claims — systems from our engineering practice.</p>
      <div class="work-grid" data-glow-grid>
        {work.map((wk, i) => (
          <a
            class={`work-cell rv ${i === 0 ? 'work-cell--lead' : ''}`}
            style={`--rv-d: ${i * 0.07}s`}
            href={href(`/work/${wk.id}/`)}
          >
            <div class="work-top">
              <span class="mono steel">{wk.data.designation}</span>
              <span class="chip" data-state={statusKey(wk.data.status)}>{wk.data.status}</span>
            </div>
            <h3 class={i === 0 ? 'h2' : 'h3'} transition:name={`work-${wk.id}`}>{wk.data.title}</h3>
            <p class="dim work-sum">{wk.data.summary}</p>
            {i === 0 && (
              <ul class="work-scope" aria-label="System scope">
                <li class="mono">Stock</li>
                <li class="mono">Sales</li>
                <li class="mono">Records</li>
                <li class="mono">Workflow</li>
              </ul>
            )}
            <span class="mono work-disc">{wk.data.discipline}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 — developers -->
  <section class="section" aria-labelledby="s6">
    <div class="shell dev-split">
      <div>
        <div class="sect-head">
          <span class="idx">06</span>
          <h2 class="lbl" id="s6">Developers</h2>
          <span class="rule rule-draw"></span>
        </div>
        <p class="h2 kin">Build on the AVATOR platform.</p>
        <p class="body-copy rv">
          The capabilities inside AVATOR products are being engineered as a
          programmable platform: documented APIs, usage-based plans and the
          same reliability bar we hold ourselves to. The interface below is a
          design preview of that surface — public documentation arrives with
          the first release.
        </p>
        <div class="hero-cta rv">
          <a class="btn" href={href('/developers/')}>
            The developer platform <span class="tick" aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={`mailto:${SITE.contactEmail}?subject=Developer%20access%20—%20AVATOR%20platform`}>
            Request early access <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <figure class="console rv" style="--rv-d: 0.15s" aria-label="API interface preview">
        <figcaption class="console-bar">
          <span class="mono">avator·platform — interface preview</span>
          <span class="console-lights" aria-hidden="true"><i></i><i></i><i></i></span>
        </figcaption>
        <pre class="console-body" aria-hidden="true" tabindex="-1"><code>$ curl https://api.avator.example/v1/language/extract \
    -H "Authorization: Bearer avt_&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" \
    -d &#123; "document": "invoice_0042.pdf",
        "schema":   "line_items"        &#125;

<span class="c-dim">// design preview — not yet public</span>
<span class="c-ok">200</span> &#123;
  "items":  [ &#8230; ],
  "fields": <span class="c-sig">"structured, validated, auditable"</span>,
  "status": <span class="c-ok">"engineered before announced"</span>
&#125;<span class="cursor" aria-hidden="true"></span></code></pre>
      </figure>
    </div>
  </section>

  <!-- 07 — enterprise -->
  <section class="section" aria-labelledby="s7">
    <div class="shell">
      <div class="sect-head">
        <span class="idx">07</span>
        <h2 class="lbl" id="s7">Enterprise</h2>
        <span class="rule rule-draw"></span>
      </div>
      <div class="ent-split">
        <p class="statement kin">
          Serious systems for serious organizations.
        </p>
        <div>
          <p class="body-copy rv">
            AVATOR engages with large organizations directly: private
            deployments, custom systems built against your constraints, and
            engineering-level conversations from the first meeting — no layers
            between you and the people who build.
          </p>
          <ul class="ent-list rv" style="--rv-d: 0.1s">
            <li><span class="mono steel">ENT·01</span> Private and dedicated deployments</li>
            <li><span class="mono steel">ENT·02</span> Custom systems and integrations</li>
            <li><span class="mono steel">ENT·03</span> Security and data-boundary review</li>
            <li><span class="mono steel">ENT·04</span> Custom agreements and licensing</li>
          </ul>
          <div class="hero-cta rv" style="--rv-d: 0.2s">
            <a class="btn btn--solid" href={href('/enterprise/')}>
              Enterprise access <span class="tick" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 — research -->
  <section class="section" aria-labelledby="s8">
    <div class="shell">
      <div class="sect-head">
        <span class="idx">08</span>
        <h2 class="lbl" id="s8">Research &amp; experiments</h2>
        <span class="rule rule-draw"></span>
      </div>
      <div class="res-split">
        <p class="h2 kin">Published when real. Never before.</p>
        <div class="res-log">
          {research.map((r) => (
            <a class="res-row rv" href={href('/company/#research')}>
              <span class="mono sig">{r.data.designation}</span>
              <span class="res-title">{r.data.title}</span>
              <span class="mono steel">{r.data.date}</span>
            </a>
          ))}
          <p class="mono steel res-note rv">Further field notes publish as work matures.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 — company -->
  <section class="section" aria-labelledby="s9">
    <div class="shell">
      <div class="sect-head">
        <span class="idx">09</span>
        <h2 class="lbl" id="s9">Company</h2>
        <span class="rule rule-draw"></span>
      </div>
      <div class="co-band">
        <p class="statement kin">
          Independent by design.<br />
          <span class="dim">Ambitious by necessity.</span>
        </p>
        <div>
          <p class="body-copy rv">
            AVATOR AI TECHNOLOGIES was founded by {SITE.founder} as an
            independent company — no template, no borrowed playbook. Small,
            deliberate, and building an ecosystem meant to outlast every trend
            cycle.
          </p>
          <div class="hero-cta rv" style="--rv-d: 0.1s">
            <a class="text-link" href={href('/company/')}>
              The company <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* 01 — hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: clip;
    border-bottom: 1px solid var(--line);
  }

  .hero-glow {
    left: 46%;
    top: 8%;
    width: min(60vw, 900px);
    aspect-ratio: 1.3;
    z-index: 0;
  }

  .hero-in {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: 8rem 6rem;
    will-change: transform;
  }

  .hero-eyebrow {
    color: var(--steel);
    letter-spacing: 0.26em;
    margin-bottom: 1.6rem;
  }

  .hero-id {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em 1.4rem;
    font-size: var(--t-hero);
    line-height: 0.86;
    font-weight: 640;
    font-stretch: 120%;
    letter-spacing: -0.015em;
    margin-left: -0.04em;
  }

  .hero-tail {
    font-size: clamp(0.72rem, 1.4vw, 1rem);
    letter-spacing: 0.42em;
    color: var(--signal);
    font-weight: 400;
  }

  .hero-statement {
    margin-top: 2.2rem;
    max-width: 13em;
  }

  .hero-sub {
    margin-top: 1.4rem;
    max-width: 34em;
    color: var(--bone-1);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.4rem;
    align-items: center;
  }

  .hero-coord,
  .hero-scroll {
    position: absolute;
    bottom: 1.4rem;
    z-index: 3;
    color: var(--steel);
    letter-spacing: 0.18em;
  }

  .hero-coord {
    left: var(--gutter);
  }

  .hero-scroll {
    left: 50%;
    transform: translateX(-50%);
    animation: cue 2.8s var(--ease-out) infinite;
  }

  @keyframes cue {
    50% {
      opacity: 0.35;
      transform: translateX(-50%) translateY(4px);
    }
  }

  @media (max-width: 900px) {
    .hero-scroll {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .hero-coord {
      display: none;
    }
  }

  /* 02 — what we build */
  .manifesto {
    max-width: 20em;
  }

  .build-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
    margin-top: 3.2rem;
    max-width: 68rem;
  }

  /* 03 — technology index */
  .tech-index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .tech-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(14rem, 0.9fr) 1.6fr auto 2rem;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--sp-ui) var(--ease-out);
    padding-inline: 0.8rem;
    margin-inline: -0.8rem;
  }

  .tech-row:hover,
  .tech-row:focus-visible {
    background: var(--ink-1);
  }

  .tech-code {
    color: var(--steel);
    letter-spacing: 0.18em;
  }

  .tech-sum {
    color: var(--bone-1);
    font-size: 0.95rem;
    max-width: 44em;
  }

  .tech-arrow {
    color: var(--steel-dim);
    justify-self: end;
    transition: color var(--sp-ui), transform var(--sp-ui) var(--ease-out);
  }

  .tech-row:hover .tech-arrow {
    color: var(--signal);
    transform: translateX(4px);
  }

  @media (max-width: 1060px) {
    .tech-row {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'code chip' 'name arrow' 'sum sum';
      row-gap: 0.5rem;
    }

    .tech-code { grid-area: code; }
    .tech-name { grid-area: name; }
    .tech-sum { grid-area: sum; }
    .tech-row .chip { grid-area: chip; justify-self: end; }
    .tech-arrow { grid-area: arrow; }
  }

  /* 04 — products */
  .prod-split > div:first-child {
    max-width: 36rem;
  }

  .prod-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .prod-cta {
    margin-top: 1.8rem;
  }

  .prod-split .body-copy {
    margin-top: 1.4rem;
  }

  .offer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .offer-list li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.5rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  .offer-code {
    color: var(--signal);
    letter-spacing: 0.18em;
    padding-top: 0.4rem;
  }

  .offer-list p {
    margin-top: 0.4rem;
    font-size: 0.95rem;
  }

  /* 05 — work */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: 2.5rem;
  }

  .work-cell {
    position: relative;
    background: var(--ink-0);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 15rem;
    transition: background-color var(--sp-ui) var(--ease-out);
  }

  /* amber keyline revealed around the cursor */
  .work-cell::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border: 1px solid rgba(240, 161, 62, 0.55);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    -webkit-mask-image: radial-gradient(
      420px 420px at var(--mx, 50%) var(--my, 50%),
      #000 0%,
      rgba(0, 0, 0, 0.5) 40%,
      transparent 70%
    );
    mask-image: radial-gradient(
      420px 420px at var(--mx, 50%) var(--my, 50%),
      #000 0%,
      rgba(0, 0, 0, 0.5) 40%,
      transparent 70%
    );
  }

  .work-cell:hover::after {
    opacity: 1;
  }

  .work-cell:hover,
  .work-cell:focus-visible {
    background: var(--ink-1);
  }

  .work-cell--lead {
    grid-row: span 2;
    justify-content: space-between;
  }

  /* with an even remainder the final cell takes the full row */
  .work-grid > .work-cell:last-child:nth-child(even) {
    grid-column: 1 / -1;
  }

  .work-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .work-sum {
    font-size: 0.95rem;
    max-width: 34em;
  }

  .work-scope {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .work-scope li {
    border: 1px solid var(--line-strong);
    color: var(--steel);
    padding: 0.45em 0.9em;
    letter-spacing: 0.16em;
  }

  .work-disc {
    color: var(--steel);
    letter-spacing: 0.16em;
    margin-top: auto;
  }

  /* 06 — developers */
  .dev-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .dev-split .body-copy {
    margin-top: 1.4rem;
  }

  .dev-split .hero-cta {
    margin-top: 2rem;
  }

  .console {
    margin: 0;
    border: 1px solid var(--line-strong);
    background: var(--ink-1);
    box-shadow:
      inset 0 0.5px rgba(255, 255, 255, 0.18),
      0 0 0 0.5px rgba(0, 0, 0, 0.8);
  }

  .console-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--steel);
  }

  .console-bar .mono {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .console-lights {
    display: inline-flex;
    gap: 6px;
  }

  .console-lights i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-3);
  }

  .console-lights i:first-child {
    background: var(--signal);
  }

  .console-body {
    padding: 1.3rem 1.1rem 1.5rem;
    overflow-x: auto;
    font-family: var(--f-mono);
    font-size: 0.78rem;
    line-height: 1.75;
    color: var(--bone-1);
  }

  /* keep right breathing room visible when the sample scrolls */
  .console-body code {
    display: inline-block;
    padding-right: 1.1rem;
  }

  /* terminal print-in as the console scrolls into view */
  :global(.js) .console-body code {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1.2s steps(14);
    transition-delay: 0.2s;
  }

  .console.in .console-body code {
    clip-path: inset(0 0 -5% 0);
  }

  @media (max-width: 720px) {
    .console-body {
      font-size: 0.7rem;
    }
  }

  .c-dim { color: var(--steel); }
  .c-ok { color: var(--signal); }
  .c-sig { color: var(--bone-0); }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    background: var(--signal);
    vertical-align: text-bottom;
    margin-left: 2px;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
  }

  /* 07 — enterprise */
  .ent-split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .ent-split .statement {
    max-width: 11em;
  }

  .ent-list {
    list-style: none;
    padding: 0;
    margin: 1.8rem 0 0;
    border-top: 1px solid var(--line);
  }

  .ent-list li {
    display: flex;
    gap: 1.4rem;
    align-items: baseline;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
