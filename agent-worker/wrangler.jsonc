{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avator-guide",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI — used for voice transcription (no extra API key needed).
  "ai": { "binding": "AI" },

  // Non-secret configuration. The provider API key is NOT here —
  // set it with:  npx wrangler secret put ANTHROPIC_API_KEY
  "vars": {
    "ALLOWED_ORIGINS": "https://hridoysamadder01-coder.github.io,http://localhost:4321,http://127.0.0.1:4321,http://127.0.0.1:4477",
    "MODEL": "claude-opus-5",
    "MAX_TURNS": "12",
    "VERSION": "1.0.0",
    "MOCK_MODE": "false"
  }
}
