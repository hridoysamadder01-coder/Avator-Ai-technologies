{
  "name": "avator-guide-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Secure backend for AVATOR Guide \u2014 the solution-routing agent of avator.ai-technologies",
  "scripts": {
    "dev": "wrangler dev",
    "dev:mock": "wrangler dev -c wrangler.dev.jsonc",
    "deploy": "npm run knowledge && wrangler deploy",
    "knowledge": "node ../scripts/build-agent-knowledge.mjs",
    "check": "tsc --noEmit",
    "secret:key": "wrangler secret put ANTHROPIC_API_KEY"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.124.0"
  }
}