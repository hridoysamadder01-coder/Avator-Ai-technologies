{
  // Local development config — no Workers AI binding (it requires Cloudflare
  // auth even in dev). Mock mode never touches AI, so local runs need nothing.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avator-guide",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321,http://127.0.0.1:4477",
    "MODEL": "claude-opus-5",
    "MAX_TURNS": "12",
    "VERSION": "1.0.0-dev",
    "MOCK_MODE": "true"
  }
}
